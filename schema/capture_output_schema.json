{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyScanCaptureOutput",
  "type": "object",
  "required": [
    "capture_id",
    "tier",
    "device_model",
    "timestamp",
    "processing_time_sec",
    "drift_corrected",
    "property_summary",
    "rooms",
    "multi_room_stitched_plan",
    "damage_regions",
    "concealed_damage_flags",
    "scope_line_items"
  ],
  "properties": {
    "capture_id": { "type": "string" },
    "tier": { "type": "string", "enum": ["photos", "video", "lidar"] },
    "device_model": { "type": "string" },
    "timestamp": { "type": "string" },
    "processing_time_sec": { "type": "number" },
    "drift_corrected": { "type": "boolean" },
    "property_summary": {
      "type": "object",
      "required": ["total_floor_area_sq_m", "total_rooms", "confidence_interval"],
      "properties": {
        "total_floor_area_sq_m": { "type": "number" },
        "total_rooms": { "type": "integer" },
        "confidence_interval": {
          "type": "object",
          "required": ["lower", "upper", "margin_pct"],
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "margin_pct": { "type": "number" }
          }
        }
      }
    },
    "rooms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["room_id", "name", "dimensions", "walls", "openings"],
        "properties": {
          "room_id": { "type": "string" },
          "name": { "type": "string" },
          "dimensions": {
            "type": "object",
            "required": ["ceiling_height_m", "floor_area_sq_m", "perimeter_m"],
            "properties": {
              "ceiling_height_m": { "type": "number" },
              "ceiling_height_ci": {
                "type": "object",
                "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
              },
              "floor_area_sq_m": { "type": "number" },
              "floor_area_ci": {
                "type": "object",
                "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
              },
              "perimeter_m": { "type": "number" }
            }
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["wall_id", "length_m", "start_point", "end_point"],
              "properties": {
                "wall_id": { "type": "string" },
                "length_m": { "type": "number" },
                "length_ci": {
                  "type": "object",
                  "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
                },
                "start_point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "end_point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "orientation_deg": { "type": "number" }
              }
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["opening_id", "wall_id", "type", "width_m", "height_m"],
              "properties": {
                "opening_id": { "type": "string" },
                "wall_id": { "type": "string" },
                "type": { "type": "string", "enum": ["door", "window", "passageway"] },
                "width_m": { "type": "number" },
                "width_ci": {
                  "type": "object",
                  "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
                },
                "height_m": { "type": "number" },
                "offset_from_wall_start_m": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "multi_room_stitched_plan": {
      "type": "object",
      "required": ["adjacency_graph", "room_placements", "drift_metric_m"],
      "properties": {
        "adjacency_graph": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["room_a", "room_b", "connector_type", "shared_opening_id"],
            "properties": {
              "room_a": { "type": "string" },
              "room_b": { "type": "string" },
              "connector_type": { "type": "string" },
              "shared_opening_id": { "type": "string" }
            }
          }
        },
        "room_placements": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["translation", "rotation_deg", "polygon"],
            "properties": {
              "translation": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "rotation_deg": { "type": "number" },
              "polygon": {
                "type": "array",
                "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              }
            }
          }
        },
        "drift_metric_m": { "type": "number" }
      }
    },
    "damage_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["damage_id", "room_id", "surface_id", "surface_type", "damage_class", "metric_extent_sq_m", "severity"],
        "properties": {
          "damage_id": { "type": "string" },
          "room_id": { "type": "string" },
          "surface_id": { "type": "string" },
          "surface_type": { "type": "string", "enum": ["wall", "ceiling", "floor"] },
          "damage_class": { "type": "string" },
          "metric_extent_sq_m": { "type": "number" },
          "extent_ci": {
            "type": "object",
            "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
          },
          "severity": { "type": "string", "enum": ["minor", "moderate", "severe"] },
          "location_polygon": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "concealed_damage_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag_id", "rule_id", "rule_name", "surface_id", "risk_level", "description", "action_required"],
        "properties": {
          "flag_id": { "type": "string" },
          "rule_id": { "type": "string" },
          "rule_name": { "type": "string" },
          "surface_id": { "type": "string" },
          "room_id": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "description": { "type": "string" },
          "action_required": { "type": "string" }
        }
      }
    },
    "scope_line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_item_id", "item_code", "category", "description", "surface_id", "quantity", "unit", "estimated_cost_usd"],
        "properties": {
          "line_item_id": { "type": "string" },
          "item_code": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "surface_id": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "unit_cost_usd": { "type": "number" },
          "estimated_cost_usd": { "type": "number" }
        }
      }
    }
  }
}
